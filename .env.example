# Set this to the final HTTPS origin before a production build.
# This is public configuration, not a secret. Leave empty for local development.
VITE_SITE_URL=

# Server-only contact settings (Vercel). Never prefix secrets with VITE_.
# HTTPS origin with no trailing slash, e.g. the real deployed portfolio origin.
CONTACT_ORIGIN=
# A verified Resend sender EMAIL ADDRESS only (not your recipient).
CONTACT_FROM=
RESEND_API_KEY=
# Cloudflare Turnstile keys; restrict the widget to the deployed hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=